{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "dist",
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["es2021", "esnext"],
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "coverage", "test", "dist"]
}
